void Init_Ports(void) {                     //call and initialize all ports
    //initializing all ports
    Init_Port1();
    Init_Port2();
    Init_Port3();
    Init_Port4();
    Init_Port5();
    Init_Port6();
    Turn_Off_Motors();
    Forward_Test();
    //end
}
void Init_Port1(void) { // Configure Port 2
    // Port 1 Pins
    //#define RED_LED                (0x01) // 1.0 RED LED 0
    //#define V_A1_SEEED             (0x02) // 1.1 A1_SEEED
    //#define V_DETECT_L             (0x04) // 1.2 V_DETECT_L
    //#define V_DETECT_R             (0x08) // 1.3 V_DETECT_R
    //#define V_A4_SEEED             (0x10) // 1.4 A4_SEEED
    //#define V_THUMB                (0x20) // 1.5 V_THUMB
    //#define UCA0RXD                (0x40) // 1.6 Back Channel UCA0RXD
    //#define UCA0TXD                (0x80) // 1.7 Back Channel UCA0TXD

    P1DIR = 0x00;                           //Set P1 direction to input
    P1OUT = 0x00;                           //P1 set Low

    //P1_0
    P1SEL0 &= ~RED_LED;                     //Set RED_LED as GP I/O
    P1SEL1 &= ~RED_LED;                     //Set RED_LED as GP I/O
    P1OUT  |= RED_LED;                      //Set RED_LED On
    P1DIR |= RED_LED;                       //Set RED_LED direction to output

    //P1_1
    //CHECK
    P1SELC |= V_A1_SEEED;                   //ADC input for V_A1_SEEED

    //P1_2
    P1SELC |= V_DETECT_L;                   //ADC input for V_DETECT_L

    //P1_3
    P1SELC |= V_DETECT_R;                   //ADC input for V_DETECT_R

    //P1_4
    P1SELC |= V_A4_SEEED;                   //ADC input for V_A4_SEEED

    //P1_5
    P1SELC |= V_THUMB;                      //ADC input for V_THUMB

    //P1_6
    P1SEL0 |=  UCA0RXD;                     //Set UCA0 Receiver
    P1SEL1 &= ~UCA0RXD;                     //Set UCA0 Receiver

    //P1_7
    P1SEL0 |=  UCA0TXD;                     //Set UCA0 Transmitter
    P1SEL1 &= ~UCA0TXD;                     //Set UCA0 Transmitter
} //end Init_Port1()

void Init_Port2(void){ // Configure Port 2
    // Port 2 Pins
    //#define SLOW_CLK (0x01)               // 0 SLOW_CLK
    //#define CHECK_BAT (0x02)              // 1 Check ADC Voltages
    //#define IR_LED (0x04)                 // 2 IR_LED
    //#define SW2 (0x08)                    // 3 SW2
    //#define IOT_RUN_RED (0x10)            // 4 IOT_RUN_RED
    //#define DAC_ENB (0x20)                // 5 DAC_ENB
    //#define LFXOUT (0x40)                 // 6 XOUTR
    //#define LFXIN (0x80)                  // 7 XINR
//------------------------------------------------------------------------------
    P2OUT = 0x00;                           // P2 set Low
    P2DIR = 0x00;                           // Set P2 direction to INPUT

    P2SEL0 |= SLOW_CLK;                    // SLOW_CLK TB1.1 operation
    P2SEL1 &= ~SLOW_CLK;                    // SLOW_CLK TB1.1 operation
    P2DIR |= SLOW_CLK;                      // Direction = output

    P2SEL0 |= CHECK_BAT;                   // CHECK_BAT TB1.2 operation
    P2SEL1 &= ~CHECK_BAT;                   // CHECK_BAT TB1.2 operation
    P2DIR |= CHECK_BAT;                     // Direction = output

    P2SEL0 &= ~IR_LED;                      // P2_2 GPIO operation
    P2SEL1 &= ~IR_LED;                      // P2_2 GPIO operation
    P2OUT &= ~IR_LED;                       // Initial Value = Low / Off
    P2DIR |= IR_LED;                        // Direction = output

    P2SEL0 &= ~SW2;                         // SW2 Operation
    P2SEL1 &= ~SW2;                         // SW2 Operation
    P2OUT |= SW2;                           // Configure pullup resistor
    P2DIR &= ~SW2;                          // Direction = input
    P2REN |= SW2;                           // Enable pullup resistor

    P2SEL0 &= ~IOT_RUN_RED;                 // IOT_RUN_CPU GPIO operation
    P2SEL1 &= ~IOT_RUN_RED;                 // IOT_RUN_CPU GPIO operation
    P2OUT &= ~IOT_RUN_RED;                  // Initial Value = Low / Off
    P2DIR |= IOT_RUN_RED;                   // Direction = output

    P2SEL0 &= ~DAC_ENB;                     // DAC_ENB GPIO operation
    P2SEL1 &= ~DAC_ENB;                     // DAC_ENB GPIO operation
    P2OUT |= DAC_ENB;                       // Initial Value = High
    P2DIR |= DAC_ENB;                       // Direction = output

    P2SEL0 &= ~LFXOUT;                      // LFXOUT Clock operation
    P2SEL1 |= LFXOUT;                       // LFXOUT Clock operation

    P2SEL0 &= ~LFXIN;                       // LFXIN Clock operation
    P2SEL1 |= LFXIN;                        // LFXIN Clock operation
//------------------------------------------------------------------------------
} //end Init_Port2()

void Init_Port3(void) {
    // Port 3 Pins
    //#define TEST_PROBE (0x01)             // 0 TEST PROBE
    //#define OA2O (0x02)                   // 1 OA2O
    //#define OA2N (0x04)                   // 2 OA2N
    //#define OA2P (0x08)                   // 3 OA2P
    //#define SMCLK (0x10)                  // 4 SMCLK
    //#define DAC_CNTL (0x20)               // 5 DAC signal from Processor
    //#define IOT_LINK_GRN (0x40)           // 6 IOT_LINK_GRN
    //#define IOT_EN (0x80)                 // 7 IOT_EN

    //P3
    P3OUT = 0x00;                           // P3 set LOW
    P3DIR = 0x00;                           // P3 direction: INPUT

    //P3_0
    P3SEL0 &= ~TEST_PROBE;                  //P3_1 GPIO operation
    P3SEL1 &= ~TEST_PROBE;                  //P3_1 GPIO operation
    P3OUT &= ~TEST_PROBE;                   //Initial value = LOW
    P3DIR |= TEST_PROBE;                    //Direction = output

    //P3_1
    P3SELC |= OA2O;                         //OA2O Operation

    //P3_2
    P3SELC |= OA2N;                         //OA2- Operation

    //P3_3
    P3SELC |= OA2P;                         //OA2+ Operation

    //P3_4
    P3SEL0 |= SMCLK;                        //SMCLK operation
    P3SEL1 &= ~SMCLK;                       //SMCLK operation
    P3DIR |= SMCLK;                         //Direction = Output

    //P3_5
    P3SELC |= DAC_CNTL;                     //P3_5 OA3O operation

    //P3_6
    P3SEL0 &= ~IOT_LINK_GRN;                //P3_5 GPIO operation
    P3SEL1 &= ~IOT_LINK_GRN;                //P3_5 GPIO operation
    P3OUT &= ~IOT_LINK_GRN;                 //Set input as LOW
    P3DIR &= ~IOT_LINK_GRN;                 //Set direction = INPUT

    //P3_7
    P3SEL0 &= ~IOT_EN;                      //P3_5 GPIO operation
    P3SEL1 &= ~IOT_EN;                      //P3_5 GPIO operation
    P3OUT &= ~IOT_EN;                       //Set output as LOW
    P3DIR |= IOT_EN;                        //Set direction = OUTPUT
} //end Init_Port3()

void Init_Port4(void){ // Configure PORT 4
    // Port 4 Pins
    //#define RESET_LCD (0x01)              // 0 RESET_LCD
    //#define SW1 (0x02)                    // 1 SW1
    //#define UCA1RXD (0x04)                // 2 Back Channel UCA1RXD
    //#define UCA1TXD (0x08)                // 3 Back Channel UCA1TXD
    //#define UCB1_CS_LCD (0x10)            // 4 Chip Select
    //#define UCB1CLK (0x20)                // 5 SPI mode - clock output—UCB1CLK
    //#define UCB1SIMO (0x40)               // 6 UCB1SIMO
    //#define UCB1SOMI (0x80)               // 7 UCB1SOMI
//------------------------------------------------------------------------------
    P4OUT = 0x00;                           // P4 set Low
    P4DIR = 0x00;                           // Set P4 direction to INPUT

    P4SEL0 &= ~RESET_LCD;                   // RESET_LCD GPIO operation
    P4SEL1 &= ~RESET_LCD;                   // RESET_LCD GPIO operation
    P4OUT &= ~RESET_LCD;                    // Initial Value = Low / Off
    P4DIR |= RESET_LCD;                     // Direction = output

    P4SEL0 &= ~SW1;                         // SW1 GPIO operation
    P4SEL1 &= ~SW1;                         // SW1 GPIO operation
    P4OUT |= SW1;                           // Configure pullup resistor
    P4DIR &= ~SW1;                          // Direction = input
    P4REN |= SW1;                           // Enable pullup resistor

    P4SEL0 |= UCA1TXD;                      // USCI_A1 UART operation
    P4SEL1 &= ~UCA1TXD;                     // USCI_A1 UART operation

    P4SEL0 |= UCA1RXD;                      // USCI_A1 UART operation
    P4SEL1 &= ~UCA1RXD;                     // USCI_A1 UART operation

    P4SEL0 &= ~UCB1_CS_LCD;                 // UCB1_CS_LCD GPIO operation
    P4SEL1 &= ~UCB1_CS_LCD;                 // UCB1_CS_LCD GPIO operation
    P4OUT |= UCB1_CS_LCD;                   // Set SPI_CS_LCD Off [High]
    P4DIR |= UCB1_CS_LCD;                   // Set SPI_CS_LCD direction to output

    P4SEL0 |= UCB1CLK;                      // UCB1CLK SPI BUS operation
    P4SEL1 &= ~UCB1CLK;                     // UCB1CLK SPI BUS operation

    P4SEL0 |= UCB1SIMO;                     // UCB1SIMO SPI BUS operation
    P4SEL1 &= ~UCB1SIMO;                    // UCB1SIMO SPI BUS operation

    P4SEL0 |= UCB1SOMI;                     // UCB1SOMI SPI BUS operation
    P4SEL1 &= ~UCB1SOMI;                    // UCB1SOMI SPI BUS operation
//------------------------------------------------------------------------------
} //end Init_Port4()

void Init_Port5(void) { // Configure PORT 5
    // Port 5 Pins
    //#define V_BAT                  (0x01) // 5.1 V_BAT
    //#define V_5_0                  (0x02) // 5.0 V_5_0
    //#define V_DAC                  (0x04) // 5.2 V_DAC
    //#define V_3_3                  (0x08) // 5.3 V_3_3
    //#define IOT_BOOT_CPU           (0x10) // 5.4 IOT_BOOT_CPU

    //P5
    P5OUT = 0x00;                           //P5 set LOW
    P5DIR = 0x00;                           // set direction as INPUT

    //P5_0
    P5SELC |= V_BAT;                        //P5.0 ADC operation

    //P5_1
    P5SELC |= V_5_0;                        //P5.1 ADC operation

    //P5_2
    P5SELC |= V_DAC;                        //P5.2 ADC operation

    //P5_3
    P5SELC |= V_3_3;                        //P5.3 ADC operation

    //P5_4
    P5SEL0 &= ~IOT_BOOT_CPU;                //P5_4 GPIO operation
    P5SEL1 &= ~IOT_BOOT_CPU;                //P5_4 GPIO operation
    P5OUT &= ~IOT_BOOT_CPU;                 //Set input to LOW
    P5DIR &= ~IOT_BOOT_CPU;                 //set direction = INPUT
}

void Init_Port6(void) { // Configure PORT 6
    // Port 6 Pins
    //#define LCD_BACKLITE           (0x01) // 6.0 LCD_BACKLITE
    //#define R_FORWARD              (0x02) // 6.1 P6_1_PWM
    //#define L_FORWARD              (0x04) // 6.2 P6_2_PWM
    //#define R_REVERSE              (0x08) // 6.3 P6_3_PWM
    //#define L_REVERSE              (0x10) // 6.3 P6_3_PWM
    //#define P6_5                   (0x20) // 6.5
    //#define GRN_LED                (0x40) // 6.6 GREEN LED

    //P6
    P6OUT = 0x00;
    P6DIR = 0x00;

    //P6_0
    P6SEL0 &= ~LCD_BACKLITE;                       //P6_0 GPIO operation
    P6SEL1 &= ~LCD_BACKLITE;                       //P6_0 GPIO operation
    P6OUT |= LCD_BACKLITE;                        //Set output to high
    P6DIR |= LCD_BACKLITE;                         //set direction = OUTPUT

    //P6_1
    P6SEL0 &= ~R_FORWARD;                       //P6_1 GPIO operation
    P6SEL1 &= ~R_FORWARD;                       //P6_1 GPIO operation
    P6OUT &= ~R_FORWARD;                        //Set output to LOW
    P6DIR |= R_FORWARD;                         //set direction = OUTPUT

    //P6_2
    P6SEL0 &= ~L_FORWARD;                       //P6_2 GPIO operation
    P6SEL1 &= ~L_FORWARD;                       //P6_2 GPIO operation
    P6OUT &= ~L_FORWARD;                        //Set output to LOW
    P6DIR |= L_FORWARD;                         //set direction = OUTPUT

    //P6_3
    P6SEL0 &= ~R_REVERSE;                       //P6_3 GPIO operation
    P6SEL1 &= ~R_REVERSE;                       //P6_3 GPIO operation
    P6OUT &= ~R_REVERSE;                        //Set output to LOW
    P6DIR |= R_REVERSE;                         //set direction = OUTPUT

    //P6_4
    P6SEL0 &= ~L_REVERSE;                       //P6_4 GPIO operation
    P6SEL1 &= ~L_REVERSE;                       //P6_4 GPIO operation
    P6OUT &= ~L_REVERSE;                        //Set output to LOW
    P6DIR |= L_REVERSE;                         //set direction = OUTPUT

    //P6_5
    P6SEL0 &= ~P6_5;                            //P6_5 GPIO operation
    P6SEL1 &= ~P6_5;                            //P6_5 GPIO operation
    P6OUT &= ~P6_5;                             //Set output to LOW
    P6DIR |= P6_5;                              //set direction = OUTPUT

    //P6_6
    P6SEL0 &= ~GRN_LED;                         //P6_6 GPIO operation
    P6SEL1 &= ~GRN_LED;                         //P6_6 GPIO operation
    P6OUT &= ~GRN_LED;                          //Set output to LOW
    P6DIR |= GRN_LED;                           //set direction = OUTPUT

    //ensure all wheel drive directions are off
    P6OUT &= ~L_FORWARD;                        // Set Port pin Low [Wheel Off]
    P6OUT &= ~R_FORWARD;                        // Set Port pin Low [Wheel Off]
    P6OUT &= ~L_REVERSE;                        // Set Port pin Low [Wheel Off]
    P6OUT &= ~R_REVERSE;                        // Set Port pin Low [Wheel Off]

}

void Turn_Off_Motors(void) { //function to turn off all motors
    // Port 6 Pins
    //#define LCD_BACKLITE           (0x01) // 6.0 LCD_BACKLITE
    //#define R_FORWARD              (0x02) // 6.1 P6_1_PWM
    //#define L_FORWARD              (0x04) // 6.2 P6_2_PWM
    //#define R_REVERSE              (0x08) // 6.3 P6_3_PWM
    //#define L_REVERSE              (0x10) // 6.3 P6_3_PWM
    //#define P6_5                   (0x20) // 6.5
    //#define GRN_LED                (0x40) // 6.6 GREEN LED
    //ensure all wheel drive directions are off
        P6OUT &= ~L_FORWARD;                        // Set Port pin Low [Wheel Off]
        P6OUT &= ~R_FORWARD;                        // Set Port pin Low [Wheel Off]
        P6OUT &= ~L_REVERSE;                        // Set Port pin Low [Wheel Off]
        P6OUT &= ~R_REVERSE;                        // Set Port pin Low [Wheel Off]
}

void Forward_Test(void) { //test if forward movement works
    // Port 6 Pins
    //#define LCD_BACKLITE           (0x01) // 6.0 LCD_BACKLITE
    //#define R_FORWARD              (0x02) // 6.1 P6_1_PWM
    //#define L_FORWARD              (0x04) // 6.2 P6_2_PWM
    //#define R_REVERSE              (0x08) // 6.3 P6_3_PWM
    //#define L_REVERSE              (0x10) // 6.3 P6_3_PWM
    //#define P6_5                   (0x20) // 6.5
    //#define GRN_LED                (0x40) // 6.6 GREEN LED

    P6OUT |= L_FORWARD; // Set Port pin High [Wheel On]
    P6OUT |= R_FORWARD; // Set Port pin High [Wheel On]
    P1OUT &= ~RED_LED;  // Set RED_LED Low [off]
    P1OUT |= RED_LED;   // Set RED_LED High [on]
    P1OUT &= ~RED_LED;  // Set RED_LED Low [off]
    P6OUT &= ~L_FORWARD;// Set Port pin Low [Wheel Off]
    P6OUT &= ~R_FORWARD;// Set Port pin Low [Wheel Off]

    unsigned int time_keeper = 0;
    P6OUT |= L_FORWARD;
    P6OUT |= R_FORWARD;
    P1OUT |= RED_LED;

    while (time_keeper < 100) {
        time_keeper += 1;
    }
    P6OUT &= ~L_FORWARD;
    P6OUT &= ~R_FORWARD;
    P1OUT &= ~RED_LED;

}
