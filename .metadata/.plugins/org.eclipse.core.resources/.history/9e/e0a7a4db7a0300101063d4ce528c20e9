#define ADC_RESET (0)    //ADC reset
#define ADCSEL_0 (0b10)      //CHECK THIS 00b ADC12OSC, 01 ACLK, 10 MCLK, 11 SMCLK

volatile unsigned int ADC_Channel = 0x00;
volatile unsigned int ADC_Left_Detect = 0x0000;
volatile unsigned int ADC_Right_Detect = 0x0000;
