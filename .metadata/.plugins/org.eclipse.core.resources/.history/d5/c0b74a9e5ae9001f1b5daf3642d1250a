void run_case_straight(void) {
    if(time_change) {
        wheel_period++;
            if (right_motor_count++ >= RIGHT_COUNT_TIME) {
                P6OUT &= ~R_FORWARD;
            }
            if (left_motor_count++ >= LEFT_COUNT_TIME) {
                P6OUT &= ~L_FORWARD;
            }
            if (cycle_time >= WHEEL_COUNT_TIME) {
                cycle_time = 0;
                right_motor_count = 0;
                left_motor_count = 0;
                segment_count++;
                //Forward_Move();
            } else {
                operation = ON;
                P6OUT |= L_FORWARD;
                P6OUT |= R_FORWARD;
                Wheels_Straight_control();
            }
    }
}

void Wheels_Straight_control(void){
    switch(operation) {
        case OFF:
            P6OUT &= ~L_FORWARD;
            P6OUT &= ~R_FORWARD;
            break;
        case ON:
            if(wheel_period >= DEFINED_PERIOD){
                wheel_period = 0;
                P6OUT |= L_FORWARD;
                P6OUT |= R_FORWARD;
                strcpy(display_line[2], "slow again");
                display_changed = TRUE;
            }
            if(wheel_period >= TOO_FAST) {
                strcpy(display_line[2], " TOO FAST ");
                display_changed = TRUE;
                P6OUT &= ~L_FORWARD;
            }
            break;
            Default: break;
    }
}

void end_case(void) {
    //Forward_Off();
    state = WAIT;
    Switch_State = NONE;
    strcpy(display_line[1], "    SW    ");
    strcpy(display_line[2], "   End    ");
}

