        if (!(P4IN & SW1) /*(P4IN & SW1)*/) {            //SW1 is always 1, P4IN is the input
            sw1_position = PRESSED;
            okay_to_look_at_switch1 = NOT_OKAY;
            count_debounce_SW1 = DEBOUNCE_RESTART;
            //button press event
            // ----
            //Switch_State = SWITCH_1;
            P6OUT |=  GRN_LED;
            P1OUT &= ~RED_LED;
            strcpy(display_line[0], "   NCSU   ");
            strcpy(display_line[1], " WOLFPACK ");
            strcpy(display_line[2], "  SW_1    ");
            display_changed = TRUE;
            Shape_Count ++;
                if (Shape_Count > 2) {
                    Shape_Count = 0;
                }
                /*switch (Shape_Count) {
                case 0:
                    strcpy(display_line[0], " Triangle ");
                    strcpy(display_line[1], "    Not   ");
                    strcpy(display_line[2], "  Running ");
                    display_changed = TRUE;
                    break;
                case 1:
                    strcpy(display_line[0], " Figure 8 ");
                    strcpy(display_line[1], "    Not   ");
                    strcpy(display_line[2], "  Running ");
                    display_changed = TRUE;
                    break;
                case 2:
                    strcpy(display_line[0], "  Circle  ");
                    strcpy(display_line[1], "    Not   ");
                    strcpy(display_line[2], "  Running ");
                    display_changed = TRUE;
                    break;
                    default: break;
                }*/

            //

        }
    }

    if (count_debounce_SW1 <= DEBOUNCE_TIME) {
        count_debounce_SW1++;
    } else {
        okay_to_look_at_switch1 = OKAY;
        if (P4IN & SW1 /*!(P4IN & SW1)*/) {
            sw1_position = RELEASED;
        }
    }
}

//switch2_process wil define what occurs when switch 2 is pressed
void Switch2_Process(void) {
    //Switch 2 Configurations
    //Port 2.3

    if (okay_to_look_at_switch2 && !sw2_position) {
        if (!(P2IN & SW2) /*(P2IN & SW2)*/) {            //SW2 is always 1, P2IN is the input
            sw2_position = PRESSED;
            okay_to_look_at_switch2 = NOT_OKAY;
            count_debounce_SW2 = DEBOUNCE_RESTART;
            //button press event
            // ----
            Switch_State = SWITCH_2;
            P1OUT |=  RED_LED;
            P6OUT &= ~GRN_LED;
            strcpy(display_line[0], "          ");
            strcpy(display_line[1], " RUNNING  ");
            strcpy(display_line[2], "          ");
            display_changed = TRUE;

            //

        }
    }

    if (count_debounce_SW2 <= DEBOUNCE_TIME) {
        count_debounce_SW2++;
    } else {
        okay_to_look_at_switch2 = OKAY;
        if (P2IN & SW2 /*!(P2IN & SW2)*/) {
            sw2_position = RELEASED;
        }
    }
}
