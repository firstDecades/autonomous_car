unsigned int okay_to_look_at_switch1 = NOT_OKAY;
unsigned int okay_to_look_at_switch2 = NOT_OKAY;
unsigned int sw1_position = RELEASED;
unsigned int sw2_position = RELEASED;
unsigned int count_debounce_SW1 = DEBOUNCE_RESTART;
unsigned int count_debounce_SW2 = DEBOUNCE_RESTART;

//function for calling individual switch functions
void Switches_Process(void) {
    //calls individual switch functions, but this function will likely not be called
    Switch1_Process();
    Switch2_Process();
}


//switch1_process will define what occurs when switch 1 is pressed
